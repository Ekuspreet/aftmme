<a id="<%= label.toLowerCase().replace(/\s+/g, '-') %>" href="<%= url %><% if (typeof static !== 'undefined' && static) { %><% if (url !== "/") { %>.html<% } %><% } %>" class="btn btn-sm shadow-sm <%= isActive ? 'btn-secondary border-secondary text-secondary-content pointer-events-none' : 'border-secondary/30 bg-base-100 text-secondary hover:bg-secondary hover:text-secondary-content hover:border-secondary' %>" <%- isActive ? 'aria-current=page' : '' %>>
  <%= (label == "Committee") ? "Committees" : label %>
</a>
