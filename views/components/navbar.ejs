<% if (typeof navLinks === 'undefined') { navLinks = []; } %>

<!-- Container flex only for md and above -->
<div class=" bg-secondary/50 text-secondary-content md:p-4">
  <!-- Container -->
  <div class="flex justify-evenly md:hidden pt-2">
    <span>
      <%- include('logo', { source: '/images/college_logo.png' }) %>
    </span>
    <span>
      <%- include('logo', { source: '/images/nitdel.png' }) %>
    </span>
  </div>

  <div class="flex flex-col md:flex-row md:items-center ">

    <!-- Left logo -->
    <div class="hidden md:flex  md:flex-1 ">
      <%- include('logo', { source: '/images/college_logo.png' }) %>
    </div>

    <!-- Name: centered explicitly on md+ -->
    <div class="text-center font-bold text-h3  md:w-2/3 md:mt-0 mt-4 leading-tight flex flex-col items-center ">
      <!-- Advancements and Futuristic Trends in Mechanical and Materials Engineering -->
      <span class="text-h5 "> 12<sup>th</sup> International Conference</span> <span class="text-h6">on</span> Advancements and Futuristic Trends in Mechanical and Materials Engineering(AFTMME)
      <br>
      <span class="text-h5 font-montserrat">
        19<sup>th</sup> –20<sup>th</sup> November, 2026
      </span>

    </div>

    <!-- Right logo -->
    <div class="hidden md:flex  md:flex-1">
      <%- include('logo', { source: '/images/nitdel.png' }) %>
    </div>
  </div>


</div>



<div id="navbar" class="flex flex-wrap bg-secondary/50 justify-center gap-2 pt-6 pb-2  ">
  <% for( let index=0; index < navLinks.length; index++ ) { %>
  <%- include('navlink', { label: navLinks[index].label, url: navLinks[index].url }) %>
  <% } %>

</div>