<%
links = [
  {
    label: "Online Abstract Submission",
    href: "https://forms.gle/tciEuiCpBg3o4dWA8",
    description: "Submit your abstract for review.",
    qr: "/images/qr/abstract.jpeg"
  },
  {
    label: "Online Manuscript Submission",
    href: "https://forms.gle/T2D1m4yqLJN3muPv6",
    description: "Submit the full manuscript after preparing the paper.",
    qr: null
  },
  {
    label: "Online Registration",
    href: "https://forms.gle/dXrpGageUE6SoaUA6",
    description: "Register for participation in the conference.",
    qr: "/images/qr/registration.jpeg"
  },
  {
    label: "Abstract Template",
    href: "https://tinyurl.com/aftmme26-template-abstract",
    description: "Download the abstract preparation template.",
    qr: null
  },
  {
    label: "Manuscript Template",
    href: "https://tinyurl.com/aftmme26-template-manuscript",
    description: "Download the manuscript preparation template.",
    qr: null
  }
];

important_dates = [
  { label: "Abstract submission", date: "10th August, 2026" },
  { label: "Full Length Paper submission", date: "15th September, 2026" },
  { label: "Early bird registration", date: "20th September to 20th October, 2026" }
];

fees = [
  {
    category: "Academician and R&D",
    internationalSomme: "350 USD",
    internationalNonSomme: "500 USD",
    nationalSomme: "2000 INR",
    nationalNonSomme: "3000 INR"
  },
  {
    category: "Students and Research Scholars",
    internationalSomme: "250 USD",
    internationalNonSomme: "350 USD",
    nationalSomme: "1000 INR",
    nationalNonSomme: "1500 INR"
  },
  {
    category: "Corporate and Industrial",
    internationalSomme: "500 USD",
    internationalNonSomme: "700 USD",
    nationalSomme: "10000 INR",
    nationalNonSomme: "12000 INR"
  }
];

notes = [
  "An additional fee of INR 500 or USD 50 will be applicable after the early bird registration deadline. At least one author of each accepted paper must register and present the paper."
];
%>

<section class="bg-base-100 py-12 md:py-16">
  <div class="container mx-auto px-4 md:max-w-5xl">
    <div class="text-center mb-10">
      <%- include('../components/section_title', { text: 'Registration', level: 'h2' }) %>
      <p class="text-center text-body text-base-content/80">
        Use the official AFTMME 2026 links below for submission, templates, and registration.
      </p>
    </div>

    <article class="bg-secondary/10 p-4 border border-secondary/20 mb-10">
      <div class="bg-base-100 p-5">
        <h2 class="text-h5 font-bold text-secondary font-montserrat text-center mb-6">Important Links</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <% links.forEach(function(link){ %>
          <div class="border border-secondary/20 bg-secondary/5 p-4 flex flex-col gap-4 <%= link.qr ? 'md:flex-row md:items-center' : '' %>">
            <% if (link.qr) { %>
            <img src="<%= link.qr %>" alt="<%= link.label %> QR code" class="w-32 h-32 object-contain bg-white border border-base-300 p-2 mx-auto md:mx-0">
            <% } %>
            <div class="flex-1">
              <h3 class="text-h6 text-secondary font-montserrat font-bold mb-2"><%= link.label %></h3>
              <p class="text-body text-base-content/80 mb-4"><%= link.description %></p>
              <a href="<%= link.href %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary">Open Link</a>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </article>

    <article class="bg-secondary/10 p-4 border border-secondary/20 mb-10">
      <div class="bg-base-100 p-5">
        <h2 class="text-h5 font-bold text-secondary font-montserrat text-center mb-6">Important Dates</h2>
        <div class="grid md:grid-cols-3 gap-3">
          <% important_dates.forEach(function(item){ %>
          <div class="bg-secondary/5 p-4 border-l-4 border-secondary/40">
            <p class="text-body font-bold text-secondary"><%= item.label %></p>
            <p class="text-body text-base-content/90"><%= item.date %></p>
          </div>
          <% }) %>
        </div>
      </div>
    </article>

    <article class="bg-secondary/10 p-2 sm:p-4 border border-secondary/20">
      <div class="bg-base-100 p-2 sm:p-5">
        <h2 class="text-lg sm:text-h5 font-bold text-secondary font-montserrat text-center mb-4 sm:mb-6">
          Registration Fee
        </h2>

        <div class="w-full border border-base-300">
          <table class="table-fixed w-full text-center text-[9px] leading-tight sm:text-sm md:text-base">
            <colgroup>
              <col class="w-[24%]" />
              <col class="w-[19%]" />
              <col class="w-[19%]" />
              <col class="w-[19%]" />
              <col class="w-[19%]" />
            </colgroup>

            <thead class="bg-secondary text-secondary-content">
              <tr>
                <th rowspan="2" class="align-middle border border-base-300 px-0.5 py-1 sm:p-3 break-words">
                  Delegates
                </th>

                <th colspan="2" class="border border-base-300 px-0.5 py-1 sm:p-3 break-words">
                  International
                </th>

                <th colspan="2" class="border border-base-300 px-0.5 py-1 sm:p-3 break-words">
                  National
                </th>
              </tr>

              <tr>
                <th class="border border-base-300 px-0.5 py-1 sm:p-3 break-words">
                  SOMME
                </th>
                <th class="border border-base-300 px-0.5 py-1 sm:p-3 break-words">
                  Non-<wbr>SOMME
                </th>
                <th class="border border-base-300 px-0.5 py-1 sm:p-3 break-words">
                  SOMME
                </th>
                <th class="border border-base-300 px-0.5 py-1 sm:p-3 break-words">
                  Non-<wbr>SOMME
                </th>
              </tr>
            </thead>

            <tbody>
              <% fees.forEach(function(row){ %>
              <tr>
                <td class="font-semibold text-left sm:text-center border border-base-300 px-1 py-1.5 sm:p-3 break-words">
                  <%= row.category %>
                </td>

                <td class="border border-base-300 px-0.5 py-1.5 sm:p-3 break-words">
                  <%= row.internationalSomme %>
                </td>

                <td class="border border-base-300 px-0.5 py-1.5 sm:p-3 break-words">
                  <%= row.internationalNonSomme %>
                </td>

                <td class="border border-base-300 px-0.5 py-1.5 sm:p-3 break-words">
                  <%= row.nationalSomme %>
                </td>

                <td class="border border-base-300 px-0.5 py-1.5 sm:p-3 break-words">
                  <%= row.nationalNonSomme %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="mt-4 sm:mt-6 grid gap-2">
          <% notes.forEach(function(note){ %>
          <p class="text-xs sm:text-body bg-secondary/5 p-2 sm:p-3 border-l-4 border-secondary/40">s
            <%= note %>
          </p>
          <% }) %>
        </div>
      </div>
    </article>
    <article class="bg-secondary/10 p-4 border border-secondary/20 mt-10">
      <div class="bg-base-100 p-5">
        <h2 class="text-h5 font-bold text-secondary font-montserrat text-center mb-6">Manuscript and Publication Notes</h2>
        <div class="grid gap-3">
          <p class="text-body bg-secondary/5 p-3 border-l-4 border-secondary/40">Selected full-length papers may be recommended for publication subject to peer review, plagiarism screening, technical quality, publisher approval, formatting compliance, and publication ethics requirements. Acceptance for presentation at the conference does not automatically guarantee publication.</p>
          <p class="text-body bg-secondary/5 p-3 border-l-4 border-secondary/40">Manuscript length: 6–8 pages for proceedings paper, or as per publisher template.</p>
          <p class="text-body bg-secondary/5 p-3 border-l-4 border-secondary/40">Similarity limit: preferably below 15–20%, excluding references, depending on publisher policy.</p>
          <p class="text-body bg-secondary/5 p-3 border-l-4 border-secondary/40">Template: Springer proceedings template, if LNME proposal is approved.</p>
          <p class="text-body bg-secondary/5 p-3 border-l-4 border-secondary/40">Review result: accepted for oral/poster presentation; accepted with revision; rejected.</p>
        </div>
      </div>
    </article>
  </div>
</section>
