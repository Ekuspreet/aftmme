<%
speakers = [
  { name: "Dr. Satya Prakash", affiliation: "Ex-Emeritus Professor, IIT Roorkee", area: "Surface engineering, coatings, and materials performance" },
  { name: "Dr. Prashant Kumar Chaurasia", affiliation: "University West, Sweden", area: "Advanced manufacturing and materials engineering" },
  { name: "Dr. Tanmay Tiwari", affiliation: "The University of Akron, USA" },
  { name: "Dr. Nguyen Van Toan", affiliation: "Tohuku University, Japan" },
  { name: "Prof. Kallol Mondal", affiliation: "IIT Kanpur" },
  { name: "Prof. Pardeep Dixit", affiliation: "IIT Bombay" },
  { name: "Dr. Buta Singh Sidhu", affiliation: "DBU" },
  { name: "Dr. Sehijpal Singh", affiliation: "GNDEC, Ludhiana" },
  { name: "Dr. Harpreet Singh", affiliation: "IIT Ropar" },
  { name: "Dr. Ravikant", affiliation: "IIT Ropar" },
];
%>

<section class="bg-base-100 py-12 md:py-16">
  <div class="container mx-auto px-4 md:max-w-5xl">
    <div class="text-center">
      <%- include('../components/section_title', { text: 'Invited Speakers', level: 'h2' }) %>
      <p class="text-justify text-body">
        AFTMME 2026 will feature eminent researchers, academicians, and leaders from mechanical and materials engineering.
      </p>
      <p class="text-justify text-body mt-3">
        Detailed speaker profiles and keynote lecture titles will be updated after confirmation from the invited speakers.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
      <% speakers.forEach(function(speaker){ %>
      <article class="bg-secondary/10 border border-secondary/20 p-4">
        <div class="bg-white/90 border-l-4 border-secondary/40 p-4 h-full">
          <h3 class="text-h6 text-secondary font-montserrat font-bold mb-2"><%= speaker.name %></h3>
          <p class="text-body text-base-content/90"><%= speaker.affiliation %></p>
          <% if (speaker.area) { %>
          <p class="text-body text-base-content/90 mt-2"><strong>Area:</strong> <%= speaker.area %></p>
          <% } %>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
