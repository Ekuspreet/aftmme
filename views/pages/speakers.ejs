<%
speakers = [
  "Dr. Satya Prakash, Ex-Emeritus Professor, IIT Roorkee",
  "Dr. Prashant Kumar Chaurasia, University West, Sweden",
  "Dr. Tanmay Tiwari, The University of Akron",
  "Dr. Nguyen Van Toan, Tohuku University, Japan",
  "Prof. Kallol Mondal, IIT Kanpur",
  "Prof. Pardeep Dixit, IIT Bombay",
  "Dr. Buta Singh Sidhu, DBU",
  "Dr. Sehijpal Singh, GNDEC, Ludhiana",
  "Dr. Harpreet Singh, IIT Ropar",
  "Dr. Ravikant, IIT Ropar"
];
%>

<section class="bg-base-100 py-12 md:py-16">
  <div class="container mx-auto px-4 md:max-w-5xl">
    <div class="text-center">
      <%- include('../components/section_title', { text: 'Keynote Speakers', level: 'h2' }) %>
      <p class="text-justify text-body">
        AFTMME 2026 will feature eminent researchers, academicians, and leaders from mechanical and materials engineering.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
      <% speakers.forEach(function(speaker){ %>
      <article class="bg-secondary/10 border border-secondary/20 p-4">
        <div class="bg-white/90 border-l-4 border-secondary/40 p-4 h-full">
          <p class="text-body text-base-content/90 font-semibold"><%= speaker %></p>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>