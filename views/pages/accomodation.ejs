      </div>
      <div class="bg-secondary/10 p-4 border border-secondary/20">
        <h3 class="text-h6 text-secondary font-montserrat font-bold">Approximate Tariff Range</h3>
      </div>
      <div class="bg-secondary/10 p-4 border border-secondary/20">
        <h3 class="text-h6 text-secondary font-montserrat font-bold">Hostel Accommodation</h3>
      </div>
      <div class="bg-secondary/10 p-4 border border-secondary/20">
        <h3 class="text-h6 text-secondary font-montserrat font-bold">Travel Guidance</h3>
      </div>
      <div class="bg-secondary/10 p-4 border border-secondary/20">
        <h3 class="text-h6 text-secondary font-montserrat font-bold">Contact Person for Accommodation</h3>
      </div>
      <div class="bg-secondary/10 p-4 border border-secondary/20 md:col-span-2">
        <h3 class="text-h6 text-secondary font-montserrat font-bold">Hostel Request Deadline</h3>
      </div>
    </div>
