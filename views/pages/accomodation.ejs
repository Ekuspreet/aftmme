<%
  accomodation_contact = [
    {
      name: "Dr. Hardeep Singh Kang",
      contact: "+91-97814-04142"
    },
    {
      name: "Dr. Preet Kamal Singh",
      contact: "+91-98727-69887"
    }
  ]
%>

<section class="pt-10 mx-auto px-4 md:max-w-2/3">
  <div class="text-center ">
    <%- include('../components/section_title', { text: 'Accommodation', level: 'h2' }) %>
    <p class="text-justify text-body">
      <b>The organizing committee welcomes all delegates for ICCT-SD 2026.</b> Registered researchers and delegates attending the conference may avail accommodation facilities arranged by the host institution in the college guest house on a chargeable basis and subject to availability. Kindly provide your consent well in advance as there are limited rooms.
    </p>
    <p class="text-justify text-body mt-1">
      Researchers/ Delegates opting for hotel accommodation may either arrange it independently or seek assistance from the organizing committee. A list of recommended hotels near the conference venue will be provided upon request. Also, organizing committee will provide information regarding booking for nearby hotels.
    </p>
  </div>
</section>
<div class="divider"></div>
<section class=" mx-auto px-4 md:max-w-2/3">
  <p class="text-justify text-body">
    For any queries regarding accommodation, kindly contact:
  </p>
  <div class="my-8 grid md:grid-cols-2 gap-6 ">
    <% for(let i = 0; i < accomodation_contact.length; i++) { %>
    <div class="p-6 bg-white  border-l-4 border-secondary/30 shadow-md">
      <div class="space-y-2">
        <p class="text-sm font-semibold text-base-content/90"><%= accomodation_contact[i].name %></p>
        <div class="mt-3 pt-3 border-t border-base-300">
          <p class="text-body font-semibold text-secondary">Contact No.</p>
          <p class="text-body font-semibold text-base-content/90"><%= accomodation_contact[i].contact %></p>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</section>