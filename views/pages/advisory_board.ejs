];
%>

<section class="bg-base-100 py-12 md:py-16">
  <div class="container mx-auto px-4 md:max-w-5xl">
    <% if (advisoryBoard.length) { %>
    <article class="bg-secondary/10 p-4 border border-secondary/20">
      <h3 class="text-h6 text-secondary font-montserrat font-bold leading-tight mb-4">
        Advisory Board
      </h3>

      <div class="grid md:grid-cols-2 gap-x-6">
        <% for (let index = 0; index < advisoryBoard.length; index++) { %>
        <p class="text-base-content/90 text-body mb-2">
          <%= advisoryBoard[index] %>
        </p>
        <% } %>
      </div>
    </article>
    <% } else { %>
    <article class="bg-secondary/10 p-4 border border-secondary/20">
      <div class="bg-base-100 p-5 border-l-4 border-secondary">
        <p class="text-body text-base-content/90 leading-relaxed text-justify">Advisory Board details will be updated soon.</p>
      </div>
    </article>
    <% } %>
  </div>
</section>
