<section class="bg-base-100">
  <div class="relative overflow-hidden bg-neutral text-neutral-content">
    <img src="/images/background.jpg" alt="Guru Nanak Dev Engineering College" class="absolute inset-0 h-full w-full object-cover object-bottom opacity-30">
    <div class="absolute inset-0 bg-neutral/80"></div>

    <div class="relative container mx-auto px-4 py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
        <div class="max-w-4xl">
          <p class="text-body font-montserrat font-bold uppercase tracking-wide text-primary mb-4">
            12th International Conference
          </p>
          <h1 class="text-h2 md:text-h1 font-black font-montserrat leading-tight text-left">
            Advancements and Futuristic Trends in Mechanical and Materials Engineering
          </h1>
          <p class="text-h6 font-semibold mt-4 text-neutral-content/90">
            AFTMME 2026 | 19-20 November, 2026 | Guru Nanak Dev Engineering College, Ludhiana
          </p>

          <div class="mt-8 grid gap-3">
            <% about.forEach(function(paragraph){ %>
            <p class="text-body text-left leading-relaxed text-neutral-content/85"><%= paragraph %></p>
            <% }) %>
          </div>


          <div class="flex flex-wrap gap-3 mt-8">
            <% quick_links.forEach(function(link){ %>
            <a href="<%= link.href %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary"><%= link.label %></a>
            <% }) %>
            <a href="/cfp" class="btn btn-outline btn-primary">Conference Themes</a>
          </div>
        </div>

        <div class="bg-base-100/95 text-base-content border border-white/20 p-5 shadow-2xl">
          <% organizers.forEach(function(item){ %>
          <div class="border-l-4 border-secondary bg-secondary/10 p-4 mb-4 last:mb-0">
            <h2 class="text-h6 text-secondary font-montserrat font-bold mb-3"><%= item.title %></h2>
            <% item.names.forEach(function(name){ %>
            <p class="text-body text-base-content/90 font-semibold mb-2 last:mb-0"><%= name %></p>
            <% }) %>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>


  <section class="bg-base-100 py-12 md:py-16">
    <div class="container mx-auto px-4 md:max-w-5xl">
      <div class="text-center mb-10">
        <%- include('../components/section_title', { text: 'Publication and Indexing Opportunities', level: 'h2' }) %>
        <article class="bg-secondary/10 p-4 border border-secondary/20 mt-6">
          <div class="bg-base-100 p-5 border-l-4 border-secondary">
            <p class="text-body text-base-content/90 leading-relaxed text-justify">
              Selected peer-reviewed papers from AFTMME 2026 will be
              considered for proposed proceedings, edited volume, or journal special
              issues, subject to approval by the concerned publisher or journal. The
              organizing committee is preparing a proposal for Springer Lecture
              Notes in Mechanical Engineering and exploring special issue
              collaborations with reputed journals in mechanical engineering,
              materials engineering, smart manufacturing, and sustainable
              engineering systems.
            </p>
            <div class="mt-6 bg-secondary/5 p-4 border border-secondary/20 text-left">
              <h3 class="text-h6 text-secondary font-montserrat font-bold mb-3">Possible Journal Publication Opportunity</h3>
              <p class="text-body text-base-content/90 leading-relaxed text-justify">
                Selected high-quality AFTMME 2026 papers may also be promoted for possible submission as extended journal articles to the Discover Materials Topical Collection titled “Data-Driven and Advanced Materials for Smart Manufacturing and Energy Applications.”
              </p>
              <p class="text-body text-base-content/90 leading-relaxed text-justify mt-4">
                This is a possible publication opportunity only. All submissions to the Collection will be subject to the independent editorial assessment, peer-review process, plagiarism screening, scope suitability, and publication policies of Discover Materials and Springer Nature.
              </p>
              <div class="flex flex-col sm:flex-row gap-3 mt-5">
                <a href="/publication-opportunities" class="btn btn-secondary">View Publication Opportunities</a>
                <a href="/assets/docs/Discover_Materials_Topical_Collection_AFTMME2026.pdf" class="btn btn-outline btn-secondary">Download Discover Materials Flyer</a>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-base-100 py-8 md:py-10">
    <div class="container mx-auto px-4 md:max-w-5xl">
      <div class="text-center mb-6">
        <%- include('../components/section_title', { text: 'Proposed Springer Proceedings', level: 'h2' }) %>
        <article class="bg-secondary/10 p-4 border border-secondary/20 mt-6">
          <div class="bg-base-100 p-5 border-l-4 border-secondary">
            <p class="text-body text-base-content/90 leading-relaxed text-justify">
              The organizing committee intends to submit a proposal for selected
              peer-reviewed papers from AFTMME 2026 to be considered for
              publication in Springer’s Lecture Notes in Mechanical Engineering
              book series. Final acceptance of the proceedings proposal and
              individual papers will remain subject to Springer’s editorial
              evaluation, peer-review standards, formatting requirements, and
              publication policies.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>


  <div class="container mx-auto px-4 md:max-w-5xl my-10">
    <div class="text-center">
      <%- include('../components/section_title', { text: 'Important Dates', level: 'h2' }) %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 p-3 md:p-0">
      <% for( let i=0; i < dates.length; ++i ) { %>
      <a href="<%= dates[i].calendar_link %>" target="_blank" rel="noopener noreferrer" class="timeline-item p-4 bg-secondary/10 border border-secondary/20 hover:bg-secondary/20 transition-colors">
        <div class="text-center flex flex-col items-center">
          <div class="text-h5 font-black text-secondary"><%= dates[i].event %></div>
          <time class="font-montserrat text-h6 font-medium"><%= dates[i].date %></time>
        </div>
      </a>
      <% } %>
    </div>
  </div>
  <script>
    const conferenceDate = new Date('2026-11-19T09:00:00+05:30').getTime();
  </script>
</section>


<section class="bg-base-100 py-12 md:py-16">
  <div class="container mx-auto px-4 md:max-w-5xl">
