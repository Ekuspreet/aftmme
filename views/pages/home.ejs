            <% for( let index=0; index < hotels_nearby.length; index++ ) { %>
            <a href="<%= hotels_nearby[index].link %>" target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-3 p-6 bg-secondary/5 border border-secondary/20 hover:border-secondary hover:shadow-md transition-all duration-300 group">
