<% tracks = [
  {
    track: "Advanced Materials and Applications",
    topics: [
      "Automotive and Aerospace Applications",
      "Tribological Applications",
      "Structural and Semi-Structural Applications",
      "Bio-Inspired Materials",
      "Energy Storage Materials",
      "Ballistic Impact Resistance Materials",
      "Shielding Materials",
      "Polymer and Carbon Composites"
    ]
  },
  {
    track: "Emerging Technologies and Manufacturing",
    topics: [
      "Additive Manufacturing (3D Printing)",
      "Non-Conventional manufacturing Processes",
      "Lean manufacturing",
      "Micro & Nano-Manufacturing",
      "Surface Engineering",
      "Sustainable Design and Manufacturing",
      "Six Sigma Approach in Manufacturing",
      "Modern Manufacturing Systems"
    ]
  },
  {
    track: "Simulation, Modeling, and Optimization",
    topics: [
      "Simulation and Optimization for Industrial Applications",
      "Finite Element Modeling and Simulations",
      "Modeling and Numerical Methods for Material Performance",
      "CAD, CAM, CIM, and Flexible Manufacturing Systems (FMS)",
      "Optimization of Manufacturing Parameters"
    ]
  },
  {
    track: "Quality Control and Performance Assessment",
    topics: [
      "Metrology and Quality Control in Manufacturing",
      "Long-Term and Short-Term Performance of Materials and Components",
      "Case Studies on New Materials Replacing Conventional Ones",
      "Machining of Hard Materials"
    ]
  },
  {
    track: "AI & Machine Learning in Materials Science",
    topics: [
      "AI-Driven Materials Discovery and Design",
      "Machine Learning for Predicting Material Properties",
      "AI in Manufacturing Process Optimization",
      "Deep Learning for Materials Failure Prediction and Analysis",
      "Data-Driven Approaches in Materials Engineering",
      "AI-Assisted Design and Testing of Advanced Materials for Sensors and Construction",
      "Sensors for Industrial Applications",
      "Construction and Building Materials",
      "Advanced Surveying Materials",
      "Bulk Construction Materials"
    ]
  },
];

submission_links = [
  { label: "Online Abstract Submission", href: "https://forms.gle/tciEuiCpBg3o4dWA8" },
  { label: "Online Manuscript Submission", href: "https://forms.gle/T2D1m4yqLJN3muPv6" },
  { label: "Abstract Template", href: "https://tinyurl.com/aftmme26-template-abstract" },
  { label: "Manuscript Template", href: "https://tinyurl.com/aftmme26-template-manuscript" }
];
%>

<section class="bg-base-100 py-12 md:py-16">
  <div class="container mx-auto px-4 md:max-w-5xl">
    <div class="text-center mb-10">
      <%- include('../components/section_title', { text: 'Conference Themes', level: "h2" }) %>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <% for (let index = 0; index < tracks.length; index++) { %>
      <div class="bg-secondary/10 p-4 border border-secondary/20">
        <div class="text-center mb-4">
          <h3 class="text-h6 text-secondary font-montserrat font-bold leading-tight">
            <%= tracks[index].track %>
          </h3>
        </div>

        <% for (let i = 0; i < tracks[index].topics.length; i++) { %>
        <p class="text-justify bg-base-100 p-4 text-base-content/90 text-body border border-base-200">
          <%= tracks[index].topics[i] %>
        </p>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</section>