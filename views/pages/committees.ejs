<section class="bg-base-100 py-12 md:py-16">
  <div class="container mx-auto px-4 md:max-w-5xl">
    <div class="grid md:grid-cols-2 gap-6">
      <% for (let index = 0; index < committees.length; index++) { %>
      <article class="bg-secondary/10 p-4 border border-secondary/20">
        <h3 class="text-h6 text-secondary font-montserrat font-bold leading-tight mb-4">
          <%= committees[index].title %>
        </h3>

        <% for (let i = 0; i < committees[index].members.length; i++) { %>
        <p class="text-base-content/90 text-body mb-2">
          <%= committees[index].members[i] %>
        </p>
        <% } %>
      </article>
      <% } %>
    </div>

    <section class="mt-10 bg-secondary/10 p-4 border border-secondary/20">
      <div class="bg-base-100 p-5">
        <h2 class="text-h5 font-bold text-secondary font-montserrat text-center mb-6">Publication Committee / Proceedings Editors</h2>
        <div class="grid gap-3">
          <p class="text-body text-base-content/90"><strong>Chief Proceedings Editor:</strong> Prof./Dr. Raman Kumar</p>
          <p class="text-body text-base-content/90"><strong>Proceedings Co-Editors:</strong>Dr. Sukhpal Singh Chatha, Dr. Chamkaur Jindal</p>
          <p class="text-body text-base-content/90"><strong>Technical Review Coordinators:</strong> Dr. Pardeep Jindal, Dr. Rakesh Bhatia</p>
          <p class="text-body text-base-content/90"><strong>Publication Ethics and Similarity Screening Coordinator:</strong> Dr. Ravi Kant</p>
          <p class="text-body text-base-content/90"><strong>Journal Special Issue Coordination Team:</strong> Dr. Raman Kumar, Dr. Chamkaur Jindal.</p>
